<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ARDU" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/ardu_bg</item>
        <item name="android:colorAccent">@color/ardu_accent</item>
        <item name="android:navigationBarColor">@color/ardu_bg</item>
        <item name="android:statusBarColor">@color/ardu_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/ardu_text</item>
        <item name="android:textColorSecondary">@color/ardu_text_secondary</item>
        <item name="android:buttonStyle">@style/Widget.ARDU.Button.Secondary</item>
        <item name="android:editTextStyle">@style/Widget.ARDU.EditText</item>
    </style>

    <style name="ARDU.Card" parent="">
        <item name="android:background">@drawable/ardu_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="ARDU.SectionTitle" parent="">
        <item name="android:textColor">@color/ardu_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ARDU.CardTitle" parent="">
        <item name="android:textColor">@color/ardu_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ARDU.Label" parent="">
        <item name="android:textColor">@color/ardu_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ARDU.Value" parent="">
        <item name="android:textColor">@color/ardu_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ARDU.Muted" parent="">
        <item name="android:textColor">@color/ardu_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.ARDU.Button.Secondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ardu_button_secondary</item>
        <item name="android:textColor">@color/ardu_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.ARDU.Button.Primary" parent="Widget.ARDU.Button.Secondary">
        <item name="android:background">@drawable/ardu_button_primary</item>
        <item name="android:textColor">@color/ardu_on_accent</item>
    </style>

    <style name="Widget.ARDU.Button.Icon" parent="Widget.ARDU.Button.Secondary">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
    </style>

    <style name="Widget.ARDU.Button.Scene" parent="Widget.ARDU.Button.Secondary">
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="Widget.ARDU.Button.RoundStep" parent="Widget.ARDU.Button.Secondary">
        <item name="android:minWidth">58dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Widget.ARDU.Button.Choice" parent="Widget.ARDU.Button.Secondary">
        <item name="android:background">@drawable/ardu_choice_item</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <style name="Widget.ARDU.Button.Nav" parent="Widget.ARDU.Button.Secondary">
        <item name="android:background">@drawable/ardu_nav_item</item>
        <item name="android:textColor">@color/ardu_text_secondary</item>
        <item name="android:textSize">0sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="Widget.ARDU.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/ardu_input</item>
        <item name="android:textColor">@color/ardu_text</item>
        <item name="android:textColorHint">@color/ardu_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">12dp</item>
    </style>

</resources>
