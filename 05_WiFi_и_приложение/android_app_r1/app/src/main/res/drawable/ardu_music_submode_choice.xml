<?xml version="1.0" encoding="utf-8"?>
<!-- Strong checked state for M05/M08 frequency submodes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/ardu_accent" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/ardu_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ardu_accent_dark" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/ardu_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ardu_surface_alt" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/ardu_border" />
        </shape>
    </item>
</selector>
