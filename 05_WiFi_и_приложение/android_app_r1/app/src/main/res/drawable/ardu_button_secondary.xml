<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/ardu_surface_pressed" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/ardu_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ardu_surface_alt" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/ardu_border" />
        </shape>
    </item>
</selector>
